{
  "name": "atlas-backend",
  "version": "0.5.0",
  "description": "Atlas v0.5 - BTC Market Dashboard Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test test/*.test.js test/unit/*.test.js test/integration/*.test.js test/api/*.test.js",
    "test:unit": "node --test test/unit/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "test:api": "node --test test/api/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test test/*.test.js test/unit/*.test.js test/integration/*.test.js test/api/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.0",
    "node-fetch": "^2.7.0"
  }
}
