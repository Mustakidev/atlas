# =============================================================================
# Atlas v1.5 — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Server ---
PORT=3000

# --- Data Source ---
API_URL=https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd&include_24hr_vol=true&include_24hr_change=true&include_24hr_high=true&include_24hr_low=true
SYMBOL=BTCUSDT

# --- Polling ---
REFRESH_INTERVAL=2000
CACHE_TTL=30000
MAX_HISTORY=500

# --- Logging ---
LOG_LEVEL=INFO

# --- HTTP Client ---
REQUEST_TIMEOUT=10000
MAX_RETRIES=5
INITIAL_BACKOFF=1000

# --- Confluence Thresholds ---
CONFLUENCE_BULLISH_THRESHOLD=65
CONFLUENCE_BEARISH_THRESHOLD=35

# --- API Throttle (outbound) ---
MIN_API_INTERVAL=5000
API_THROTTLE_TTL=30000

# =============================================================================
# Sprint 1 — Production Hardening
# =============================================================================

# --- Authentication ---
# Required for server-to-server API-key authentication.
# Use a generated secret with at least 32 characters. Do not commit a real key.
API_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARS
# Verifier client configuration. verify-pipeline.js reads process.env directly;
# it does not automatically load this file. Supply this through the verifier's
# process manager/secret store or exported environment, never browser code.
# It must match the server API_KEY under the current PH-2 model.
ATLAS_VERIFY_API_KEY=REPLACE_WITH_THE_SAME_RANDOM_SECRET_AS_API_KEY
# Generated scrypt verifier; never place the plaintext password here.
# Generate it locally/offline from an interactive TTY with hidden/no-echo input
# and confirmation. Never use a CLI argument or plaintext environment variable.
# Use a random 16-byte salt and fixed scrypt N=16384, r=8, p=1; store only the
# encoded verifier and never commit the password or unnecessary secret values.
ATLAS_OPERATOR_PASSWORD_HASH=REPLACE_WITH_GENERATED_SCRYPT_VERIFIER
# One canonical browser origin. Trailing slash, path, query, and hash are invalid.
# Local HTTP is supported only for localhost, 127.0.0.1, or ::1 and assumes
# loopback-only exposure. Atlas listens on all interfaces by default, so use
# network/host firewall controls when running local HTTP.
# Remote deployments must use https://<host> and ATLAS_COOKIE_SECURE=true.
ATLAS_ORIGIN=http://localhost:3000
# Use false only with the explicit local HTTP origin above. Production must use true.
ATLAS_COOKIE_SECURE=false

# --- Canonical Replay Provider ---
# CoinGecko credential for canonical replay provider access.
# Leave empty to keep canonical replay unavailable.
# This is separate from the Atlas inbound API_KEY above.
COINGECKO_API_KEY=

# --- CORS ---
# Comma-separated list of allowed origins, or * for all (not recommended).
# Example: http://localhost:3000,https://atlas.example.com
# CORS is non-credentialed; browser operator sessions remain same-origin only.
CORS_ORIGIN=http://localhost:3000

# Reverse-proxy limitation: original-client-IP rate limiting is not certified
# behind an arbitrary proxy without an explicitly designed trusted-hop setup.
# The current single-operator deployment accepts this limitation; do not use
# blanket trust proxy configuration.

# --- Body Size Limit ---
# Maximum request body size. Express format: '16kb', '100kb', '1mb'.
MAX_BODY_SIZE=16kb

# --- Rate Limiting (global) ---
# Maximum requests per window per IP.
# Frontend polls ~290 req/min (13 endpoints × 20 cycles/min + candle fetch).
RATE_LIMIT_MAX_REQUESTS=500
# Window size in milliseconds.
RATE_LIMIT_WINDOW_MS=60000

# --- Rate Limiting (expensive endpoints) ---
# Lower limit for /validation, /backtest, /analytics, /strategy/replay/v2.
RATE_LIMIT_EXPENSIVE_MAX=5
# Login attempts per IP per window.
RATE_LIMIT_LOGIN_MAX_REQUESTS=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000
